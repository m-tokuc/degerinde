# Değerinde — environment template
# Copy to .env and adjust for local / production.

# API
PORT=8000
MODEL_PATH=car_price_model.pkl

# CORS: use * for local; production Flutter web/app origins comma-separated
# Example: https://degerinde.app,https://www.degerinde.app,http://localhost:3000
CORS_ORIGINS=*

# Empty = show all brands present in araclar_clean (recommended for Tier1 growth).
# Optional temporary restrict: FOCUS_BRANDS=Fiat,Renault
FOCUS_BRANDS=

# ── Database ──
# Local host Postgres (araclar / araclar_clean):
DB_URL=postgresql+psycopg2://postgres:sifre123@localhost:5432/postgres

# Docker backend → host machine Postgres:
# DB_URL=postgresql+psycopg2://postgres:sifre123@host.docker.internal:5432/postgres

# Docker backend → compose Postgres (profile with-db):
# DB_URL=postgresql+psycopg2://postgres:sifre123@db:5432/postgres

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

POSTGRES_USER=postgres
POSTGRES_PASSWORD=sifre123
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Flutter production builds:
#   API_BASE_URL=https://api.yourdomain.com ./scripts/build_web.sh
#   API_BASE_URL=https://api.yourdomain.com ./scripts/build_apk.sh
